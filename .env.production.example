# Modèle pour une instance de production. À copier en .env sur le serveur
# (fichier ignoré par git) puis à compléter. Ne jamais versionner le .env réel.

APP_NAME=Jalon
APP_ENV=production
# Générer une clé PROPRE À CHAQUE INSTANCE : php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://jalon.tg

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# La vitrine publique reste accessible aux visiteurs non connectés.
APP_VITRINE=true
# Numéro WhatsApp de contact (format international, sans espace)
APP_WHATSAPP=

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jalon
DB_USERNAME=jalon
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="contact@jalon.tg"
MAIL_FROM_NAME="${APP_NAME}"

# Sauvegardes : php artisan jalon:sauvegarde (planifié chaque nuit à 02:30).
# Conserver les archives hors du serveur applicatif si possible.
